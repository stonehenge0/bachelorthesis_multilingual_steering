#! /bin/bash
#SBATCH --job-name=test_filepaths
#SBATCH -c 8 #
#SBATCH --mem 80G  
#SBATCH -p scc-gpu 
#SBATCH -t 06:00:00 
#SBATCH -G A100:1 
#SBATCH --output=../slurm_files/slurm-%x-%j.out     
#SBATCH --error=../slurm_files/slurm-%x-%j.err      

# Printing out some info on filepaths.
echo "Submitting job with sbatch from directory: ${SLURM_SUBMIT_DIR}"
echo "Home directory: ${HOME}"
echo "Working directory: $PWD"
echo "Current node: ${SLURM_NODELIST}"

# Python and torch info. Uncomment for debugging
python --version
# python -m torch.utils.collect_env 2> /dev/null

# Print out some git info.
module load git
echo -e "\nCurrent Branch: $(git rev-parse --abbrev-ref HEAD)"
echo "Latest Commit: $(git rev-parse --short HEAD)"
echo -e "Uncommitted Changes: $(git status --porcelain | wc -l)\n"

# Conda environment setup.
source /mnt/vast-standard/home/stein65/u14374/miniforge3/etc/profile.d/conda.sh
conda activate /mnt/vast-standard/home/stein65/u14374/miniforge3/envs/modified_lm_eval_env
echo "Activated Conda environment: $CONDA_DEFAULT_ENV"

# Run script.
# for the output path, specify the folder where it should land with the model name for example: 
# .../results/llama-3.1-8B-Instruct and the folder will be created and put everything in there.
### put all tasks and steering strengths back in
python lm_eval_steered_and_baseline_tasks.py  --task "or_bench" "multijail"  --model "meta-llama/Llama-3.1-8B-Instruct" --device "cuda:0"   --out_path "/scratch1/users/u14374/bachelorarbeit/bachelorthesis_multilingual_steering/tmp/Llama-3.1-8B-Instruct"   --wandb_project "bachelorarbeit"   --steering_direction_path "/scratch1/users/u14374/bachelorarbeit/bachelorthesis_multilingual_steering/data/Llama-3.1-8B-Instruct-direction.pt"   --steering_strengths 0.33 --steering_layer 11 --seed 42

# Clean up hf Cache.
# hf cache delete